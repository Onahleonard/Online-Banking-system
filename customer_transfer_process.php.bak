<?php
session_start();
if (!isset($_SESSION['customer_login']) || !isset($_SESSION['login_id'])) {
    header('location:login.php');
    exit();
}

include '_inc/dbconn.php';

$t_amount = floatval($_REQUEST['t_val']);
$sender_id = mysql_real_escape_string($_SESSION['login_id']);
$reciever_id = mysql_real_escape_string($_REQUEST['transfer']);

if ($t_amount < 100) {
    echo '<script>alert("Transfer amount must be at least $100.00"); window.location="customer_transfer.php";</script>';
    exit();
}

// Select details from sender's last passbook entry
$s_last_sql = "SELECT * FROM passbook" . $sender_id . " ORDER BY transactionid DESC LIMIT 1";
$s_res = mysql_query($s_last_sql);
if (!$s_res || mysql_num_rows($s_res) == 0) {
    echo '<script>alert("Unable to process transfer. Sender passbook unavailable."); window.location="customer_transfer.php";</script>';
    exit();
}
$s_row = mysql_fetch_array($s_res);
$s_amount = floatval($s_row[7]);
$s_name = $s_row[2];
$s_branch = $s_row[3];
$s_ifsc = $s_row[4];

// Minimum balance verification
if ($s_amount <= 500) {
    echo '<script>alert("Your current balance is $' . number_format($s_amount, 2) . '. You must maintain a minimum balance of $500.00 to transfer funds."); window.location="customer_transfer.php";</script>';
    exit();
}

$s_total = $s_amount - $t_amount;
if ($s_total < 500) {
    echo '<script>alert("Insufficient funds! Maintaining this transfer would leave $' . number_format($s_total, 2) . ', which falls below the mandatory $500.00 minimum balance."); window.location="customer_transfer.php";</script>';
    exit();
}

// Select details from receiver's last passbook entry
$r_last_sql = "SELECT * FROM passbook" . $reciever_id . " ORDER BY transactionid DESC LIMIT 1";
$r_res = mysql_query($r_last_sql);
if (!$r_res || mysql_num_rows($r_res) == 0) {
    echo '<script>alert("Invalid recipient account or receiver passbook unavailable."); window.location="customer_transfer.php";</script>';
    exit();
}
$r_row = mysql_fetch_array($r_res);
$r_amount = floatval($r_row[7]);
$r_name = $r_row[2];
$r_branch = $r_row[3];
$r_ifsc = $r_row[4];

$date = date("Y-m-d");
$r_total = $r_amount + $t_amount;

// Insert credit record into receiver passbook
$sql_reciever = "INSERT INTO passbook" . $reciever_id . " VALUES('', '$date', '$r_name', '$r_branch', '$r_ifsc', '$t_amount', '0', '$r_total', 'BY $s_name')";
mysql_query($sql_reciever) or die(mysql_error());

// Insert debit record into sender passbook
$sql_sender = "INSERT INTO passbook" . $sender_id . " VALUES('', '$date', '$s_name', '$s_branch', '$s_ifsc', '0', '$t_amount', '$s_total', 'TO $r_name')";
mysql_query($sql_sender) or die(mysql_error());

echo '<script>alert("Transfer of $' . number_format($t_amount, 2) . ' completed successfully."); window.location="dashboard.php";</script>';
exit();
?>
